GEMINI_API_KEY=            # Google Gemini (preferred); leave blank for the rules/template fallback
# Copy to .env (never commit it). All secrets live only on the server.
OPENAI_API_KEY=            # leave blank to run with the rules/template fallback
# AI_MODEL=gemini-3.6-flash   (or gpt-4o-mini when using OpenAI)
# AI_BASE_URL=
AI_TIMEOUT_SECONDS=20
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./bookleaf.db   # e.g. postgresql+psycopg://user:pass@host/db
SEED_AUTHOR_PASSWORD=author123
SEED_ADMIN_PASSWORD=admin123
